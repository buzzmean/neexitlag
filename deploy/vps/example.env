# Root-owned systemd EnvironmentFile. No passwords, signing keys or tokens here.
RELAY_LISTEN=0.0.0.0:4433
RELAY_METRICS=127.0.0.1:9090
RELAY_ID=VPS-01
# Replace with the actual controlled echo destination, comma-separated CIDRs.
RELAY_ALLOW_CIDRS=REPLACE_TARGET_IPV4/32
RELAY_CONTROL_PLANE=https://127.0.0.1:8443
RELAY_CONTROL_PLANE_CA_FILE=/etc/neexitlag/relay/ca.pem
