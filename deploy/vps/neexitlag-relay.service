[Unit]
Description=neexitlag authenticated QUIC relay
After=network-online.target neexitlag-control-plane.service
Wants=network-online.target
[Service]
User=neexitlag-relay
Group=neexitlag-relay
EnvironmentFile=/etc/neexitlag/public/relay.env
ExecStart=/opt/neexitlag/bin/relay -listen :4433 -metrics 127.0.0.1:9090 -cert /etc/neexitlag/relay/server.pem -key /etc/neexitlag/relay/server.key -ca /etc/neexitlag/relay/ca.pem -relay-id VPS-01 -ticket-keys /etc/neexitlag/relay/trust.json -replay-cache /var/lib/neexitlag/replay.json -control-plane https://127.0.0.1:8443 -control-plane-ca /etc/neexitlag/relay/ca.pem -heartbeat-token-file /etc/neexitlag/relay/heartbeat.token -allow-cidrs ${VPS_PUBLIC_IP}/32
StateDirectory=neexitlag
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
[Install]
WantedBy=multi-user.target
