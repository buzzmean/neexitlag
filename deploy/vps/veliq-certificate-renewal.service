[Unit]
Description=VELIQ server certificate renewal
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=neexitlag-fresh
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/neexitlag/maintenance/renew-server-cert.py run
TimeoutStartSec=170
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/neexitlag /var/backups/neexitlag-certificates /var/lib/neexitlag-fresh /run
