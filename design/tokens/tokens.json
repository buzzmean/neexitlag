{
  "$description": "VELIQ design tokens. Единственный источник: правьте этот файл и запускайте python3 design/tools/build-tokens.py — он пересоберёт tokens.css и разложит его в website/ и app-ui/.",
  "color": {
    "primitive": {
      "ink-950": "#0A0A0B",
      "ink-900": "#131417",
      "ink-850": "#1A1C20",
      "ink-800": "#22252A",
      "ink-700": "#30343B",
      "ink-600": "#474C55",
      "ink-500": "#696F79",
      "ink-400": "#8E939C",
      "ink-300": "#B5B9BF",
      "ink-200": "#D6D9DD",
      "ink-100": "#E9EBEE",
      "ink-50": "#F4F5F7",
      "white": "#FFFFFF",
      "signal-300": "#FF8C6B",
      "signal-500": "#F0502A",
      "signal-600": "#D8431F",
      "signal-700": "#B03413",
      "fjord-400": "#7FA2FF",
      "fjord-600": "#3D63D6",
      "ok-400": "#3CCB8B",
      "ok-600": "#13804F",
      "warn-400": "#F2C14A",
      "warn-600": "#9A6A00",
      "danger-400": "#FF6B7F",
      "danger-600": "#C42A42"
    },
    "light": {
      "bg": "{white}",
      "bg-sunken": "{ink-50}",
      "bg-raised": "{white}",
      "bg-inverse": "{ink-950}",
      "line": "{ink-100}",
      "line-strong": "{ink-200}",
      "text": "{ink-950}",
      "text-muted": "{ink-600}",
      "text-faint": "{ink-500}",
      "text-inverse": "{white}",
      "accent": "{signal-500}",
      "accent-text": "{signal-700}",
      "on-accent": "{ink-950}",
      "control": "{ink-950}",
      "on-control": "{white}",
      "control-hover": "{ink-800}",
      "data-direct": "{ink-500}",
      "data-hel": "{signal-500}",
      "data-swe": "{fjord-600}",
      "ok": "{ok-600}",
      "warn": "{warn-600}",
      "danger": "{danger-600}",
      "focus": "{signal-500}"
    },
    "dark": {
      "bg": "{ink-950}",
      "bg-sunken": "#060607",
      "bg-raised": "{ink-900}",
      "bg-inverse": "{white}",
      "line": "{ink-800}",
      "line-strong": "{ink-700}",
      "text": "{white}",
      "text-muted": "{ink-300}",
      "text-faint": "{ink-400}",
      "text-inverse": "{ink-950}",
      "accent": "{signal-500}",
      "accent-text": "{signal-300}",
      "on-accent": "{ink-950}",
      "control": "{white}",
      "on-control": "{ink-950}",
      "control-hover": "{ink-100}",
      "data-direct": "{ink-400}",
      "data-hel": "{signal-500}",
      "data-swe": "{fjord-400}",
      "ok": "{ok-400}",
      "warn": "{warn-400}",
      "danger": "{danger-400}",
      "focus": "{signal-500}"
    }
  },
  "font": {
    "family": {
      "sans": "\"Onest\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, -apple-system, Roboto, sans-serif"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 620, "bold": 720, "display": 820 },
    "size": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "21px",
      "2xl": "26px",
      "3xl": "33px",
      "4xl": "42px",
      "5xl": "54px",
      "6xl": "70px",
      "display": "clamp(54px, 9.4vw, 136px)"
    },
    "leading": { "tight": 0.94, "snug": 1.15, "normal": 1.5, "relaxed": 1.62 },
    "tracking": { "display": "-0.045em", "heading": "-0.025em", "normal": "0", "wide": "0.01em" }
  },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px", "10": "128px" },
  "radius": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "20px",
    "xl": "28px",
    "q": "36%",
    "pill": "999px",
    "$note": "q — радиус контура буквы Q из логотипа (36 на 100). Только для главных объектов: большая кнопка, иконка приложения."
  },
  "slit": {
    "position": "66%",
    "thickness": "6%",
    "$note": "Срез из логотипа: прорезь на 66% высоты, толщина 6% высоты. Повторяется в большой кнопке, заголовках, индикаторе маршрута."
  },
  "shadow": {
    "none": "none",
    "pop": "0 1px 0 rgba(10,10,11,.04), 0 18px 40px -12px rgba(10,10,11,.30)",
    "pop-dark": "0 0 0 1px rgba(255,255,255,.06), 0 24px 48px -12px rgba(0,0,0,.7)"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "420ms", "route": "1400ms" },
    "easing": { "out": "cubic-bezier(.2,.8,.2,1)", "route": "cubic-bezier(.65,0,.35,1)" }
  },
  "layout": {
    "container": "1240px",
    "gutter": "clamp(16px, 4vw, 40px)",
    "columns": 12,
    "measure": "64ch"
  },
  "app": {
    "window": { "width": "1040px", "height": "680px", "min-width": "860px", "min-height": "580px" },
    "rail": "208px",
    "titlebar": "40px"
  }
}
