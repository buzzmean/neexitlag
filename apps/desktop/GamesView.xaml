<UserControl x:Class="Neexitlag.Desktop.GamesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Neexitlag.Desktop">
 <!-- Title and hint come from the MainWindow page header (app-ui/index.html, «Игры»). -->
 <DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <Grid MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,8">
    <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="{ui:Tr GameCatalogSearch}" AutomationProperties.Name="{ui:Tr GameCatalogSearch}" Padding="34,0,10,0" Width="360" Margin="0"/>
    <Path Data="{StaticResource IconSearch}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource TextFaint}" StrokeThickness="1.75" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/>
   </Grid>
   <TextBlock Text="{Binding Notice}" Style="{StaticResource Small}" Margin="0,4,0,12" Visibility="{Binding Notice, Converter={StaticResource EmptyToCollapsed}}"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <ItemsControl ItemsSource="{Binding Games}" IsEnabled="{Binding CanInteract}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Card}" Padding="16">
     <DockPanel>
      <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Background="{StaticResource BgSunken}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top" Margin="0,0,16,0">
       <TextBlock Text="{Binding Icon}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel>
       <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17"/>
       <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0"><Run Text="{Binding Launcher, Mode=OneWay}"/><Run Text="{Binding AntiCheat, Mode=OneWay, StringFormat=' · {0}'}"/></TextBlock>
       <TextBlock Text="{Binding Compatibility}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
       <WrapPanel Margin="0,12,0,0">
        <ComboBox Width="170" Margin="0,0,8,0" ItemsSource="{Binding DataContext.Modes,RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode,UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="{ui:Tr GameCatalogApply}" Click="Apply" Style="{StaticResource Primary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <Button Content="{ui:Tr GameCatalogRepair}" Click="Repair" IsEnabled="{Binding CanRepair}" Margin="0" VerticalAlignment="Center"/>
       </WrapPanel>
       <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" Margin="0,10,0,0" Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}"/>
      </StackPanel>
     </DockPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
 </DockPanel>
</UserControl>
