<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Neexitlag.Desktop" x:Class="Neexitlag.Desktop.MainWindow" Title="VELIQ" Icon="Assets/NeExitLag.ico" Width="1240" Height="820" MinWidth="920" MinHeight="620" Background="#000000" FontFamily="Segoe UI" FontSize="14" Language="ru-RU" WindowStartupLocation="CenterScreen">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#141414" BorderBrush="#303030" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,26">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="VELIQ" FontSize="28" FontWeight="Bold" Margin="12,0,0,4"/>
     <TextBlock Text="{ui:Tr AppSubtitle}" Foreground="#FFFFFF" FontSize="12" Margin="12,0,0,28"/>
     <Button Content="{ui:Tr Home}" Tag="Home" Click="Navigate" HorizontalContentAlignment="Left"/>
     <Button Content="{ui:Tr Applications}" Tag="Applications" Click="Navigate"/>
     <Button Content="{ui:Tr Routes}" Tag="Routes" Click="Navigate"/>
     <Button Content="{ui:Tr Statistics}" Tag="Statistics" Click="Navigate"/>
     <Button Content="{ui:Tr Diagnostics}" Tag="Diagnostics" Click="Navigate"/>
     <Button Content="{ui:Tr LocalStrategies}" Tag="LocalStrategies" Click="Navigate"/>
     <Button Content="{ui:Tr Settings}" Tag="Settings" Click="Navigate"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{ui:Tr ServiceHint}" TextWrapping="Wrap" Foreground="#A3A3A3" FontSize="12" Margin="12,24,12,0" VerticalAlignment="Bottom"/>
   </DockPanel>
  </Border>
  <DockPanel Grid.Column="1" Margin="30,24">
   <StackPanel DockPanel.Dock="Top">
    <DockPanel><TextBlock x:Name="PageTitle" Text="{ui:Tr Home}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding Connection}" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/></DockPanel>
    <DockPanel Margin="0,10,0,0"><Button Content="{ui:Tr Retry}" Click="Reconnect" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="{Binding Error}" Foreground="#FFB49D" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Text="{Binding Notice}" Foreground="#A3A3A3" TextWrapping="Wrap" Margin="0,4,0,12"/>
   </StackPanel>
   <Grid>
    <ScrollViewer x:Name="Home" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="#1A1A1A" BorderBrush="#404040" BorderThickness="1" CornerRadius="16" Padding="24">
      <StackPanel><TextBlock Text="{Binding OptimizationStatus}" FontSize="18"/><TextBlock Text="{ui:Tr CurrentRoute}" Foreground="#A3A3A3" Margin="0,18,0,4"/><TextBlock Text="{Binding Primary}" FontSize="32" FontWeight="SemiBold"/>
       <TextBlock Text="{ui:Tr RouteScopeHint}" Foreground="#A3A3A3" TextWrapping="Wrap" Margin="0,8,0,14"/>
       <Button Content="{Binding OptimizeLabel}" Background="#404040" BorderBrush="#BDBDBD" HorizontalAlignment="Left" IsEnabled="{Binding CanControl}" Click="ToggleOptimize"/>
      </StackPanel>
     </Border>
     <UniformGrid Columns="2" Margin="0,14,0,0">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{ui:Tr DirectLatency}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding DirectLatency}" Style="{StaticResource Metric}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{ui:Tr RelayLatency}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding RelayLatency}" Style="{StaticResource Metric}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{ui:Tr Jitter}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Jitter}" Style="{StaticResource Metric}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{ui:Tr PacketLoss}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Loss}" Style="{StaticResource Metric}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{ui:Tr Received}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Rx}" Style="{StaticResource Metric}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{ui:Tr Sent}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Tx}" Style="{StaticResource Metric}"/></StackPanel></Border>
     </UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{ui:Tr ActiveApps}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ActiveApps}" FontSize="18" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
     <TextBlock Text="{ui:Tr MeasurementsHint}" Style="{StaticResource Hint}"/><TextBlock Text="{ui:Tr CaptureHint}" Style="{StaticResource Hint}"/>
    </StackPanel></ScrollViewer>
    <DockPanel x:Name="Applications" Visibility="Collapsed">
     <StackPanel DockPanel.Dock="Top"><WrapPanel>
      <Button Content="{ui:Tr AddApplication}" Click="AddApplication" IsEnabled="{Binding CanControl}"/>
      <Button Content="{ui:Tr ChromeSites}" Click="OpenChromeSites" IsEnabled="{Binding CanControl}"/>
      <Button Content="{ui:Tr DisableChromeSites}" Click="DisableChromeSites"/>
      <Button Content="{ui:Tr EdgeSites}" Click="OpenEdgeSites" IsEnabled="{Binding CanControl}"/>
      <Button Content="{ui:Tr DisableEdgeSites}" Click="DisableEdgeSites" IsEnabled="{Binding CanControl}"/>
      <Button Content="{ui:Tr RemoveApplication}" Click="DeleteApplication" IsEnabled="{Binding CanControl}"/>
     </WrapPanel><Button Content="{ui:Tr AutoOptimize}" Click="UseAuto" IsEnabled="{Binding CanControl}" HorizontalAlignment="Left"/><Expander x:Name="AppAdvanced" Header="{ui:Tr AdvancedDiagnostics}"><StackPanel><WrapPanel>
      <ComboBox x:Name="Mode" ItemsSource="{Binding Modes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedIndex="0" SelectionChanged="ModeChanged"/>
      <ComboBox x:Name="ProfileFallback" ItemsSource="{Binding ProfileFallbacks}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedIndex="0"/>
      <ComboBox x:Name="RelayChoice" ItemsSource="{Binding Relays}" DisplayMemberPath="Label" SelectedValuePath="Value" MinWidth="190" IsEnabled="False"/>
      <Button Content="{ui:Tr Apply}" Click="ApplyMode" IsEnabled="{Binding CanControl}"/>
     </WrapPanel><WrapPanel><ComboBox x:Name="AppPreset" DisplayMemberPath="Label" SelectedValuePath="Id" MinWidth="180"/><CheckBox x:Name="AppQuic" IsChecked="True" Content="{ui:Tr QuicFallback}"/><Button Content="{ui:Tr ApplyPreset}" Click="ApplyPreset" IsEnabled="{Binding CanControl}"/></WrapPanel><TextBlock Text="{ui:Tr ApplicationSelectionHint}" Style="{StaticResource Hint}"/>
      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Applications}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding LocalDetails}" TextWrapping="Wrap" Style="{StaticResource Hint}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     </StackPanel></Expander></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding EdgeState}" Style="{StaticResource Hint}"/><DataGrid ItemsSource="{Binding EdgeDomains}" MaxHeight="140"><DataGrid.Columns><DataGridTextColumn Header="{ui:Tr EdgeDomainLabel}" Binding="{Binding Domain}" Width="*"/><DataGridTextColumn Header="{ui:Tr CurrentRoute}" Binding="{Binding Route}" Width="140"/><DataGridTextColumn Header="{ui:Tr ReasonLabel}" Binding="{Binding Reason}" Width="2*"/><DataGridTextColumn Header="{ui:Tr TransportOutcome}" Binding="{Binding Outcome}" Width="2*"/></DataGrid.Columns></DataGrid><TextBlock Text="{Binding ChromePolicyState}" Style="{StaticResource Hint}"/><TextBlock Text="{ui:Tr ChromeSitesHint}" Style="{StaticResource Hint}"/><DataGrid ItemsSource="{Binding BrowserDomains}" MaxHeight="180"><DataGrid.Columns><DataGridTextColumn Header="{ui:Tr DomainLabel}" Binding="{Binding Domain}" Width="*"/><DataGridTextColumn Header="{ui:Tr CurrentRoute}" Binding="{Binding Route}" Width="140"/><DataGridTextColumn Header="{ui:Tr ReasonLabel}" Binding="{Binding Reason}" Width="2*"/><DataGridTextColumn Header="{ui:Tr Result}" Binding="{Binding Outcome}" Width="2*"/></DataGrid.Columns></DataGrid></StackPanel>
     <DataGrid x:Name="AppGrid" ItemsSource="{Binding Applications}" SelectionChanged="ApplicationSelected" SelectionMode="Single"><DataGrid.Columns>
      <DataGridTextColumn Header="{ui:Tr Application}" Binding="{Binding Name}" Width="150"/>
      <DataGridTextColumn Header="{ui:Tr Executable}" Binding="{Binding Path}" Width="2*"/>
      <DataGridTextColumn Header="{ui:Tr Mode}" Binding="{Binding Mode}" Width="120"/>
      <DataGridTextColumn Header="{ui:Tr ProcessStatus}" Binding="{Binding ProcessStatus}" Width="130"/>
      <DataGridTextColumn Header="{ui:Tr CurrentRoute}" Binding="{Binding UserStatus}" Width="250"/>
      <DataGridTextColumn Header="{ui:Tr UdpTraffic}" Binding="{Binding Udp}" Width="130" Visibility="Collapsed"/>
      <DataGridTextColumn Header="{ui:Tr TcpTraffic}" Binding="{Binding Tcp}" Width="130" Visibility="Collapsed"/>
      <DataGridTextColumn Header="{ui:Tr IPv4Label}" Binding="{Binding Ipv4}" Width="130" Visibility="Collapsed"/>
      <DataGridTextColumn Header="{ui:Tr IPv6Label}" Binding="{Binding Ipv6}" Width="180" Visibility="Collapsed"/>
     <DataGridTextColumn Header="{ui:Tr LocalDetails}" Binding="{Binding LocalDetails}" Width="300" Visibility="Collapsed"/>
     </DataGrid.Columns></DataGrid>
    </DockPanel>
    <DockPanel x:Name="Routes" Visibility="Collapsed"><TextBlock DockPanel.Dock="Top" Text="{ui:Tr RoutesHint}" Style="{StaticResource Hint}"/>
     <DataGrid ItemsSource="{Binding Routes}"><DataGrid.Columns>
      <DataGridTextColumn Header="{ui:Tr CurrentRoute}" Binding="{Binding Name}" Width="*"/>
      <DataGridTextColumn Header="{ui:Tr RouteStatus}" Binding="{Binding Status}" Width="125"/>
      <DataGridTextColumn Header="{ui:Tr Latency}" Binding="{Binding Rtt}" Width="110"/>
      <DataGridTextColumn Header="{ui:Tr Jitter}" Binding="{Binding Jitter}" Width="100"/>
      <DataGridTextColumn Header="{ui:Tr PacketLoss}" Binding="{Binding Loss}" Width="115"/>
      <DataGridTextColumn Header="{ui:Tr Score}" Binding="{Binding Score}" Width="95"/>
      <DataGridTextColumn Header="{ui:Tr RouteRole}" Binding="{Binding Role}" Width="125"/>
      <DataGridTextColumn Header="{ui:Tr BurstLoss}" Binding="{Binding Burst}" Width="110"/>
      <DataGridTextColumn Header="{ui:Tr Stability}" Binding="{Binding Stability}" Width="125"/>
      <DataGridTextColumn Header="{ui:Tr Samples}" Binding="{Binding SampleCount}" Width="160"/>
      <DataGridTextColumn Header="{ui:Tr MedianPing}" Binding="{Binding Median}" Width="155"/>
      <DataGridTextColumn Header="{ui:Tr P95Ping}" Binding="{Binding P95}" Width="130"/>
     </DataGrid.Columns></DataGrid>
    </DockPanel>
    <DockPanel x:Name="Statistics" Visibility="Collapsed"><StackPanel DockPanel.Dock="Top">
     <WrapPanel Margin="0,0,0,16">
      <StackPanel Margin="4,0,24,0"><TextBlock Text="{ui:Tr Latency}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CurrentLatency}" FontSize="18"/></StackPanel>
      <StackPanel Margin="4,0,24,0"><TextBlock Text="{ui:Tr Jitter}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Jitter}" FontSize="18"/></StackPanel>
      <StackPanel Margin="4,0,24,0"><TextBlock Text="{ui:Tr PacketLoss}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Loss}" FontSize="18"/></StackPanel>
      <StackPanel Margin="4,0,24,0"><TextBlock Text="{ui:Tr Received}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Rx}" FontSize="18"/></StackPanel>
      <StackPanel Margin="4,0,24,0"><TextBlock Text="{ui:Tr Sent}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Tx}" FontSize="18"/></StackPanel>
     </WrapPanel><WrapPanel>
      <StackPanel Margin="4,0,24,0"><TextBlock Text="{ui:Tr BurstLoss}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CurrentBurst}" FontSize="18"/></StackPanel>
      <StackPanel Margin="4,0,24,0"><TextBlock Text="{ui:Tr Stability}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CurrentStability}" FontSize="18"/></StackPanel>
      <StackPanel Margin="4,0,24,0"><TextBlock Text="{ui:Tr Samples}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CurrentSamples}" FontSize="18"/></StackPanel>
     </WrapPanel><TextBlock Text="{ui:Tr QualityScope}" Style="{StaticResource Hint}"/><TextBlock Text="{ui:Tr RecentMeasurements}" FontSize="20"/><TextBlock Text="{ui:Tr MeasurementsHint}" Style="{StaticResource Hint}"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><TextBlock Text="{ui:Tr RouteChanges}" FontSize="20"/><ListBox ItemsSource="{Binding Changes}" Height="130" Background="#111111" Foreground="#FFFFFF" BorderBrush="#333333"/></StackPanel>
     <DataGrid ItemsSource="{Binding Measurements}"><DataGrid.Columns>
      <DataGridTextColumn Header="{ui:Tr Time}" Binding="{Binding Time}" Width="110"/>
      <DataGridTextColumn Header="{ui:Tr CurrentRoute}" Binding="{Binding Route}" Width="*"/>
      <DataGridTextColumn Header="{ui:Tr Latency}" Binding="{Binding Rtt}" Width="130"/>
      <DataGridTextColumn Header="{ui:Tr Jitter}" Binding="{Binding Jitter}" Width="130"/>
      <DataGridTextColumn Header="{ui:Tr PacketLoss}" Binding="{Binding Loss}" Width="130"/>
     </DataGrid.Columns></DataGrid>
    </DockPanel>
    <DockPanel x:Name="Diagnostics" Visibility="Collapsed"><StackPanel DockPanel.Dock="Top"><Button Content="{ui:Tr RunDiagnostics}" HorizontalAlignment="Left" Click="RunDiagnostics" IsEnabled="{Binding CanControl}"/><TextBlock Text="{ui:Tr DiagnosticMtu}" Style="{StaticResource Hint}"/><TextBlock Text="{Binding BrowserStartupSummary}" Style="{StaticResource Hint}"/></StackPanel>
     <DataGrid ItemsSource="{Binding Diagnostics}"><DataGrid.Columns>
      <DataGridTextColumn Header="{ui:Tr Check}" Binding="{Binding Name}" Width="180"/>
      <DataGridTextColumn Header="{ui:Tr Result}" Binding="{Binding Status}" Width="140"/>
      <DataGridTextColumn Header="{ui:Tr Details}" Binding="{Binding Detail}" Width="*"/>
     </DataGrid.Columns></DataGrid>
    </DockPanel>

    <ScrollViewer x:Name="LocalStrategies" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <WrapPanel><Button Content="{ui:Tr DiscordPreset}" Tag="discord" Click="QuickPreset"/><Button Content="{ui:Tr YouTubePreset}" Tag="youtube" Click="QuickPreset"/></WrapPanel>
     <TextBlock Text="{ui:Tr PresetHint}" Style="{StaticResource Hint}"/>
     <TextBlock Text="{ui:Tr LocalWarning}" TextWrapping="Wrap" Style="{StaticResource Hint}"/>
     <WrapPanel><CheckBox x:Name="LocalEnabled" Content="{ui:Tr LocalEnabled}" Margin="8"/><CheckBox x:Name="LocalAuto" Content="{ui:Tr AutoStrategy}" Margin="8"/></WrapPanel>
     <TextBlock Text="{ui:Tr LocalAutoHint}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
     <WrapPanel><Button Content="{ui:Tr LocalLoad}" Click="LoadLocal"/><Button Content="{ui:Tr LocalSave}" Click="SaveLocal" IsEnabled="{Binding CanControl}"/></WrapPanel>
     <TextBlock x:Name="LocalCounters" TextWrapping="Wrap" Style="{StaticResource Hint}"/>
     <Button Content="{ui:Tr ApplyVariant}" Click="ApplyVariant" HorizontalAlignment="Left" IsEnabled="{Binding CanControl}"/>
     <DataGrid x:Name="LocalGrid" Height="160" AutoGenerateColumns="False" SelectionChanged="SelectLocal"><DataGrid.Columns>
      <DataGridTextColumn Header="{ui:Tr PresetVersionLabel}" Binding="{Binding Name}" Width="190"/><DataGridTextColumn Header="{ui:Tr Application}" Binding="{Binding Application}" Width="*"/><DataGridTextColumn Header="{ui:Tr LocalDetails}" Binding="{Binding Advanced}" Width="420"/><DataGridTextColumn Header="{ui:Tr Enabled}" Binding="{Binding Enabled}" Width="80"/>
     </DataGrid.Columns></DataGrid>
     <TextBlock Text="{ui:Tr LocalApp}"/><TextBox x:Name="LocalApp"/>
     <ComboBox x:Name="LocalMechanism" SelectedIndex="0"><ComboBoxItem Tag="tcp-split" Content="{ui:Tr LocalTcpCustom}"/><ComboBoxItem Tag="tcp-split-1" Content="{ui:Tr LocalTcp1}"/><ComboBoxItem Tag="tcp-split-5" Content="{ui:Tr LocalTcp5}"/><ComboBoxItem Tag="udp-fragment-24" Content="{ui:Tr LocalUdp24}"/></ComboBox>
     <TextBlock Text="{ui:Tr LocalSplitPosition}"/><TextBox x:Name="LocalSplitPosition"/>
     <TextBlock Text="{ui:Tr LocalPorts}"/><TextBox x:Name="LocalPorts"/>
     <TextBlock Text="{ui:Tr LocalDomains}"/><TextBox x:Name="LocalDomains"/>
     <TextBlock Text="{ui:Tr LocalIPs}"/><TextBox x:Name="LocalIPs"/>
     <TextBlock Text="{ui:Tr LocalExcludeDomains}"/><TextBox x:Name="LocalExcludeDomains"/>
     <TextBlock Text="{ui:Tr LocalExcludeIPs}"/><TextBox x:Name="LocalExcludeIPs"/>
     <WrapPanel><Button Content="{ui:Tr LocalAdd}" Click="AddLocal"/><Button Content="{ui:Tr LocalRemove}" Click="RemoveLocal"/></WrapPanel>
     <TextBlock Text="{ui:Tr LocalURL}"/><TextBox x:Name="LocalURL"/>
     <TextBlock Text="{ui:Tr LocalToken}"/><TextBox x:Name="LocalToken"/>
     <TextBlock Text="{ui:Tr LocalCA}"/><TextBox x:Name="LocalCA"/>
     <Button Content="{ui:Tr LocalTestV2}" Click="TestLocalV2" HorizontalAlignment="Left" IsEnabled="{Binding CanControl}"/>
     <Button Content="{ui:Tr LocalTest}" Click="TestLocal" HorizontalAlignment="Left" IsEnabled="{Binding CanControl}"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="Settings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <CheckBox x:Name="Launch" Content="{ui:Tr AutoStart}"/>
     <CheckBox x:Name="StartMinimized" Content="{ui:Tr StartMinimized}"/>
     <CheckBox x:Name="MinimizeToTray" Content="{ui:Tr MinimizeToTray}"/>
     <CheckBox x:Name="Automatic" Content="{ui:Tr AutoOptimization}" IsEnabled="{Binding Available}"/>
     <WrapPanel Margin="8,8"><TextBlock Text="{ui:Tr FailureBehavior}" VerticalAlignment="Center" Width="220"/><ComboBox x:Name="Fallback" IsEnabled="{Binding Available}" DisplayMemberPath="Label" SelectedValuePath="Value" MinWidth="200"/></WrapPanel>
     <WrapPanel Margin="8,8"><TextBlock Text="{ui:Tr UpdateChannel}" VerticalAlignment="Center" Width="220"/><ComboBox x:Name="Channel" IsEnabled="{Binding Available}" DisplayMemberPath="Label" SelectedValuePath="Value" MinWidth="200"/></WrapPanel>
     <Button Content="{ui:Tr SaveSettings}" HorizontalAlignment="Left" Click="SaveSettings"/>
     <TextBlock Text="{ui:Tr SettingsScope}" Style="{StaticResource Hint}"/><TextBlock Text="{ui:Tr UpdatesHint}" Style="{StaticResource Hint}"/>
    </StackPanel></ScrollViewer>
   </Grid>
  </DockPanel>
 </Grid>
</Window>
