<?xml version="1.0" ?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Neexitlag.Desktop.App" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Text" Color="#EDF2F6"/>
    <SolidColorBrush x:Key="Panel" Color="#191E25"/>
    <SolidColorBrush x:Key="Accent" Color="#B7F46E"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EDF2F6"/>
      <Setter Property="Background" Value="#28313C"/>
      <Setter Property="BorderBrush" Value="#334050"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#191E25"/>
      <Setter Property="Foreground" Value="#EDF2F6"/>
      <Setter Property="BorderBrush" Value="#2A323E"/>
      <Setter Property="RowBackground" Value="#191E25"/>
      <Setter Property="AlternatingRowBackground" Value="#20262F"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#2A323E"/>
      <Setter Property="VerticalGridLinesBrush" Value="#2A323E"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="RowHeight" Value="42"/>
      <Setter Property="ColumnHeaderHeight" Value="42"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#242D38"/>
      <Setter Property="Foreground" Value="#A7B6C8"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EDF2F6"/>
      <Setter Property="Margin" Value="8"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinWidth" Value="150"/>
      <Setter Property="Margin" Value="8"/>
      <Setter Property="Foreground" Value="#172311"/>
    </Style>
  </Application.Resources>
</Application>
