<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Neexitlag.Desktop"
 x:Class="Neexitlag.Desktop.AddApplicationWindow" Title="{ui:Tr AddApplication}" Width="980" Height="650" MinWidth="760" MinHeight="460"
 Background="#000000" FontFamily="Segoe UI" FontSize="14" Language="ru-RU" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{ui:Tr RunningApplicationsHint}" Style="{StaticResource Hint}"/>
  <DockPanel Grid.Row="1" Margin="0,0,0,12">
   <Button DockPanel.Dock="Right" Content="{ui:Tr RefreshProcesses}" Click="RefreshProcesses" IsEnabled="{Binding CanRefresh}"/>
   <StackPanel><TextBlock Text="{ui:Tr SearchApplications}" Style="{StaticResource Caption}"/><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="4" AutomationProperties.Name="{ui:Tr SearchApplications}"/></StackPanel>
  </DockPanel>
  <DataGrid x:Name="ProcessGrid" Grid.Row="2" ItemsSource="{Binding Applications}" SelectionMode="Single" SelectionChanged="SelectionChanged" MouseDoubleClick="ChooseOnDoubleClick" MinRowHeight="82" EnableRowVirtualization="True">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="{ui:Tr Application}" SortMemberPath="Title" Width="240"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <StackPanel Orientation="Horizontal" Margin="8"><Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center" MaxWidth="174"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,4,0,0"/><TextBlock Text="{Binding ProcessSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></StackPanel>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="{ui:Tr Executable}" Binding="{Binding Path}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
    <DataGridTextColumn Header="{ui:Tr ProcessIdentifiers}" Binding="{Binding PidSummary}" Width="150"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3"><TextBlock Text="{Binding Status}" Style="{StaticResource Hint}"/><TextBlock x:Name="AddError" TextWrapping="Wrap" Foreground="#FFB4A8" Margin="4"/></StackPanel>
  <DockPanel Grid.Row="4"><Button x:Name="ManualButton" DockPanel.Dock="Left" Content="{ui:Tr ChooseFileManually}" Click="ChooseFileManually"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{ui:Tr Cancel}" IsCancel="True"/><Button x:Name="AddButton" Content="{ui:Tr Add}" Click="AddSelected" IsEnabled="False" IsDefault="True"/></StackPanel></DockPanel>
 </Grid>
</Window>
