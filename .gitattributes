* text=auto
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.ps1 text eol=lf
*.env text eol=lf

# Byte-verified resources: checkout must preserve the reviewed/signed bytes.
apps/desktop-core/Resources/GameCatalog.json text eol=lf
assets/brand/*.svg text eol=lf
core/localstrategy/catalog.json text eol=lf
core/originpolicy/registry.json text eol=lf
# Downloaded WinDivert archives and binaries are SHA256-pinned, never text.
*.zip binary
*.dll binary
*.sys binary
